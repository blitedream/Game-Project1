  m_Script: {fileID: 11500000, guid: 382211529e5168a4387536586f374197, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSequence
  introPanel: {fileID: 1211055101}
  introText: {fileID: 1481459993}
  playerController: {fileID: 0}
  lineDuration: 3.4
  lines:
  - 'Before the Zacaton assignment,

    you are brought back to the training room.'
  - 'A diver does not die only from depth.

    Panic, darkness, and bad habits do
    the rest.'
  - 'The rescue team has one rule:

    if you cannot stay calm here, you do not
    enter open water.'
  - 'Today you will repeat the basics:

    gear, breathing, entry, descent, return.'
  - 'Controls:

    WASD move, mouse look, E interact.'
  - 'Underwater:

    Hold Ctrl to descend, hold Space to ascend.'
  - 'The pool is controlled.

    The cave will not be.'
  - 'Wear the equipment.

    Enter the water when you are ready.'
